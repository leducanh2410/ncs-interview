# ============================================================
# Laravel Application Environment — PRODUCTION
# Copy this file content into GitLab CI/CD Variable:
#   Variable name: ENV_LARAVEL  |  Environment scope: prod  |  Type: File
# ============================================================

APP_NAME=Stomiru
APP_ENV=production
APP_KEY=base64:CHANGE_ME_RUN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://app.stomiru.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database — connects to container stomiru-prod-db
# DB_PASSWORD must match DB_ROOT_PASSWORD in ENV_DOCKER
DB_CONNECTION=mysql
DB_HOST=stomiru-prod-db
DB_PORT=3306
DB_DATABASE=stomiru_db
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_SAME_AS_DB_ROOT_PASSWORD

# Cache / Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail — replace with actual mail provider config
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
