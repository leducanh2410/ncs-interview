# ============================================================
# Docker Compose Environment — PRODUCTION
# Copy this file content into GitLab CI/CD Variable:
#   Variable name: ENV_DOCKER  |  Environment scope: prod  |  Type: File
# ============================================================

APP_ENV=prod

# Backend Docker Image built from branch: main
DOCKER_BACK_IMAGE=registry.gitlab.com/your-org/stomiru/backend/main:latest

# Port the PHP container exposes on the host (Nginx proxies to this)
DOCKER_PHP_PORT=8080

# Database root password — must match DB_PASSWORD in the Laravel env file
DB_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
