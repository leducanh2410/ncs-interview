APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost
APP_FRONT_URL=http://localhost:3000
APP_CDN_BASE_URL="${APP_URL}/storage"

# Include workplaces flagged as test (is_test) in admin master data.
# Defaults to false so test data stays hidden in production.
# SHOW_TEST_WORKPLACES=true

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=dgf_connect
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3600

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

AWS_REKOGNITION_COLLECTION=dgf-connect
AWS_REKOGNITION_THRESHOLD=80.0
AWS_REKOGNITION_TIMEOUT=30

PUSHER_APP_KEY=dgf-connect
PUSHER_APP_SECRET=soketi_app_secret
PUSHER_APP_ID=1
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http

CAPTCHA_TURNSTILE_SITE_KEY=
CAPTCHA_TURNSTILE_SECRET_KEY=

AUTH_TFA_ENABLED=true

# Comma-separated list of admin emails to bypass MFA even when AUTH_TFA_ENABLED=true (case-insensitive)
# Example: admin1@example.com,admin2@example.com
# Leave empty to enforce MFA for all admins (default)
AUTH_TFA_SKIP_EMAILS=

CHECK_IN_BEFORE_HOUR=1
CHECK_IN_MAX_DISTANCE=200
CHECK_IN_ANTI_SPOOFING_ENABLED=true
ABSENT_NOTICE_BEFORE_HOUR=12
MAX_WORK_HOUR_PER_WEEK=28

# Second (final) employee confirmation reminder, minutes before shift start
CONFIRM_SHIFT_FINAL_REMINDER_BEFORE_MINUTE=180
# Aggregated admin alert when employees are still unconfirmed, minutes before shift start
SHIFT_UNCONFIRMED_ALERT_BEFORE_MINUTE=120
# Aggregated admin alert when employees have not checked in, minutes after shift start
SHIFT_MISSING_CHECK_IN_ALERT_AFTER_MINUTE=10

# Comma-separated list of emails to receive system notifications
# Example: admin1@example.com,admin2@example.com
# Leave empty to disable email notifications
SYSTEM_NOTIFICATION_EMAILS=

CROSS_STAFF_BASE_URL=https://api.crossstaff.jp/cpapi
CROSS_STAFF_TENANT_CD=
CROSS_STAFF_EXTERNAL_CD=
CROSS_STAFF_API_KEY=

# OCR demo via OpenRouter (admin "Read from image")
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_ROTATION_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TIMEOUT=55

BANK_ACCOUNT_OCR_MAX_RUNS=3
BANK_ACCOUNT_MAX_IMAGES=2
BANK_ACCOUNT_MAX_IMAGE_SIZE_KB=8192
BANK_ACCOUNT_NAME_CHECK_MODEL=
BANK_ACCOUNT_NAME_CHECK_TIMEOUT=20

FIREBASE_CREDENTIALS=/var/www/google-services.json
FIREBASE_ADMIN_CREDENTIALS=/var/www/google-services-admin.json
FIREBASE_HTTP_CLIENT_TIMEOUT=15


STUDENT_CARD_EXPIRY_THRESHOLD=14
RESIDENCE_CARD_EXPIRY_THRESHOLD=14
NOTIFICATION_RETENTION_DAYS=7

DASHBOARD_CACHE_TTL=14400

# Chat auto-close lifecycle (days after shift end / inactive hours)
CHAT_SHIFT_GROUP_AUTO_CLOSE_DAYS=3
CHAT_SUPPORT_AUTO_CLOSE_INACTIVE_HOURS=24
# Closed support chat retention before permanent deletion (days, default 180)
CHAT_SUPPORT_RETENTION_DAYS=180

# Chat push notifications: active-conversation heartbeat (suppress push while viewing)
CHAT_ACTIVE_CONVERSATION_TTL=45
CHAT_PRESENCE_STORE=redis

SALARY_START_DATE=2025-08-01

ABSENCE_RECENT_WINDOW_DAYS=180

# runpod or rekognition
FACE_RECOGNITION_PROVIDER=rekognition

RUNPOD_FACE_RECOGNITION_ENDPOINT=
RUNPOD_FACE_RECOGNITION_API_KEY=
RUNPOD_FACE_RECOGNITION_TIMEOUT=30
RUNPOD_FACE_RECOGNITION_ENDPOINT_ID=

RUNPOD_ANTI_SPOOFING_ENDPOINT=
RUNPOD_ANTI_SPOOFING_API_KEY=
RUNPOD_ANTI_SPOOFING_TIMEOUT=30
RUNPOD_ANTI_SPOOFING_ENDPOINT_ID=
