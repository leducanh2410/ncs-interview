{
    "name": "frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "portless dgf next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "prettier": "./node_modules/.bin/prettier --list-different --write ./src",
        "lint": "./node_modules/.bin/eslint ./src",
        "lint:fix": "./node_modules/.bin/eslint ./src --fix",
        "trans": "i18next-scanner",
        "trans:apply": "node ./scripts/translation-workflow.mjs apply",
        "trans:cleanup": "node ./scripts/translation-workflow.mjs cleanup",
        "trans:prepare": "node ./scripts/translation-workflow.mjs prepare",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@glideapps/glide-data-grid": "^6.0.3",
        "@hello-pangea/dnd": "^18.0.1",
        "@mantine/carousel": "^9.2.1",
        "@mantine/charts": "^9.2.1",
        "@mantine/core": "^9.2.1",
        "@mantine/dates": "^9.2.1",
        "@mantine/dropzone": "^9.2.1",
        "@mantine/form": "^9.2.1",
        "@mantine/hooks": "^9.2.1",
        "@mantine/notifications": "^9.2.1",
        "@mantine/tiptap": "^9.2.1",
        "@marsidev/react-turnstile": "^1.5.3",
        "@react-input/mask": "^2.0.4",
        "@tanstack/react-query": "^5.66.7",
        "@tanstack/react-query-devtools": "^5.66.7",
        "@tiptap/extension-highlight": "^3.23.6",
        "@tiptap/extension-image": "^3.23.6",
        "@tiptap/extension-link": "^3.23.6",
        "@tiptap/extension-subscript": "^3.23.6",
        "@tiptap/extension-superscript": "^3.23.6",
        "@tiptap/extension-text-align": "^3.23.6",
        "@tiptap/extension-underline": "^3.23.6",
        "@tiptap/pm": "^3.23.6",
        "@tiptap/react": "^3.23.6",
        "@tiptap/starter-kit": "^3.23.6",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.13",
        "embla-carousel": "^8.6.0",
        "embla-carousel-react": "^8.6.0",
        "i18next": "^24.0.5",
        "i18next-browser-languagedetector": "^8.0.1",
        "japan-postal-code": "^0.3.0",
        "jotai": "^2.12.1",
        "jotai-tanstack-query": "^0.9.0",
        "laravel-echo": "^2.3.4",
        "mantine-datatable": "^9.2.2",
        "next": "^15.5.18",
        "pdfjs-dist": "^5.5.207",
        "pusher-js": "^8.5.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-i18next": "^15.1.3",
        "react-icons": "^5.5.0",
        "recharts": "^3.8.1",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/japan-postal-code": "^0.2.4",
        "@types/node": "^20.19.41",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "i18next-scanner": "^4.6.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.5.1",
        "typescript": "^5",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.5"
    },
    "prettier": {
        "tabWidth": 4,
        "printWidth": 120,
        "singleQuote": true,
        "quoteProps": "consistent",
        "importOrder": [
            "^react",
            "^next",
            "<THIRD_PARTY_MODULES>",
            "^@/[^/]+$",
            "^@/locales/(.*)$",
            "^@/layout/(.*)$",
            "^@/types/(.*)$",
            "^@/configs/(.*)$",
            "^@/enums/(.*)$",
            "^@/helpers/(.*)$",
            "^@/components/(.*)$",
            "^@/pages/(.*)(?<!(api|css))$",
            "^@/pages/(.*\\.api)$",
            "^@mantine.+\\.css$",
            "^[^@].+\\.css$",
            "^@/styles.+\\.css$",
            "^./(.*)$"
        ],
        "importOrderSortSpecifiers": true,
        "importOrderGroupNamespaceSpecifiers": true,
        "plugins": [
            "@trivago/prettier-plugin-sort-imports"
        ]
    },
    "packageManager": "pnpm@10.33.0"
}
